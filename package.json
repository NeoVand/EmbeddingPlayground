		"@types/node": "^22",
		"@types/three": "^0.185.4",
		"@webgpu/types": "^0.1.72",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@lucide/svelte": "^1.34.0",
		"three": "^0.185.1"
